<launch>

  <arg name="serial_port" default="/dev/ttyUSB0" />

  <arg name="baud_rate" default="1000000" />

  <arg name="serial_timeout" default="1000" />

  <arg name="rows" default="5" />

  <arg name="cols" default="5" />

  <arg name="tf_prefix" default="" />

  <arg name="frame_id" default="fingertip0" />

  <!-- Insert here finger ID [e.g. #F001-28A] | You MUST provide a calibration folder in <pkg-name>/Finger_files-->
  <arg name="finger_calibration_file" default="path/to/NET_FILE.txt" />

  <arg name="bool_tactile_logic_filter" default="true" />
  <arg name="bool_use_tactile_logic_filter" default="$(var bool_tactile_logic_filter)" />
  <arg name="logic_filter_voltage_thr" default="0.05" />

  <arg name="bool_filter_voltage" default="false" />
  <arg name="bool_use_filtered_voltage" default="$(var bool_filter_voltage)" />
  <arg name="filter_voltage_cut_freq" default="50.0" />
  <arg name="filter_voltage_rate" default="500.0" />

  <arg name="bool_filter_wrench" default="false" />
  <arg name="filter_wrench_cut_freq" default="50.0" />
  <arg name="filter_wrench_rate" default="500.0" />

  <!-- Invariant args -->
  <arg name="voltage_raw_topic" default="tactile_voltage/raw" />
  <arg name="voltage_raw_checked_topic" default="$(var voltage_raw_topic)_checked" />
  <arg name="voltage_rect_topic" default="tactile_voltage/rect" />
  <arg name="action_compute_bias" default="compute_bias_action" />
  <arg name="wrench_topic" default="wrench" />
  <arg name="voltage_raw_filter_topic" default="$(var voltage_raw_topic)_filter" />
  <arg name="wrench_filter_topic" default="$(var wrench_topic)_filter" />

  <!-- LEGACY -->
  <arg name="bool_mov_av_wrench" default="false" />
  <arg name="bool_use_filtered_wrench_in_mov_av" default="$(var bool_filter_wrench)" />
  <arg name="mov_av_wrench_N" default="5" />
  <arg name="mov_av_wrench_rate" default="50.0" />
  <arg name="wrench_mov_av_topic" default="$(var wrench_topic)_m_av" />

  
  <node name="read_tactile_serial"  pkg="uclv_tactile_driver" exec="read_tactile_serial" output="screen">

    <param name="serial_port" value="$(var serial_port)"/>

    <param name="baud_rate" value="$(var baud_rate)"/>

    <param name="serial_timeout" value="$(var serial_timeout)"/>

    <param name="rows" value="$(var rows)"/>
    <param name="cols" value="$(var cols)"/>

    <param name="tf_prefix" value="$(var tf_prefix)"/>
    <param name="frame_id" value="$(var frame_id)"/>

    <param name="output_topic" value="$(var voltage_raw_topic)"/>

  </node>

  <!-- <node if="$(var bool_tactile_logic_filter)" name="tactile_logic_filter"  pkg="uclv_tactile_driver" exec="tactile_logic_filter" output="screen">

    <param name="in_topic" value="$(var voltage_raw_topic)"/>

    <param name="out_topic" value="$(var voltage_raw_checked_topic)"/>

    <param name="volt_thr" value="$(var logic_filter_voltage_thr)"/>

  </node> -->

  <!-- <node if="$(var bool_filter_voltage)" name="filter_tactile"  pkg="uclv_tactile_driver" exec="filter_tactile" output="screen">

    <param name="num_voltages" value="$(eval '$cols * $rows')"/>

    <param if="$(var bool_use_tactile_logic_filter)" name="in_topic" value="$(var voltage_raw_checked_topic)"/>
    <param unless="$(var bool_use_tactile_logic_filter)" name="in_topic" value="$(var voltage_raw_topic)"/>

    <param name="out_topic" value="$(var voltage_raw_filter_topic)"/>

    <param name="cut_freq" value="$(var filter_voltage_cut_freq)"/>
    <param name="rate" value="$(var filter_voltage_rate)"/>

  </node> -->

  <node name="remove_bias"  pkg="uclv_tactile_driver" exec="remove_bias" output="screen">

    <!-- <param 
     if="$(eval (not arg('bool_use_filtered_voltage')) and (not arg('bool_use_tactile_logic_filter')))"
     name="in_voltage_topic" 
     
     value="$(var voltage_raw_topic)"
     />
    <param
     if="$(eval (not arg('bool_use_filtered_voltage')) and (arg('bool_use_tactile_logic_filter')))"
     name="in_voltage_topic" 
     
     value="$(var voltage_raw_checked_topic)"
    />
    <param 
      if="$(var bool_use_filtered_voltage)" 
      name="in_voltage_topic" 
     
      value="$(var voltage_raw_filter_topic)"
    /> -->

    <param 
     name="in_voltage_topic" 
     value="$(var voltage_raw_topic)"
     />

    <param name="out_voltage_topic" value="$(var voltage_rect_topic)"/>

    <param name="action_compute_bias" value="$(var action_compute_bias)"/>

    <param name="default_num_samples" value="100"/>

    <!-- <param name="num_voltages" value="$(eval $cols * $rows)"/> -->
    <param name="num_voltages" value="25"/>

  </node>

  <node name="read_wrench" pkg="uclv_tactile_wrench" exec="read_wrench" output="screen">

    <!-- Insert here finger ID [#A123-45B] | You MUST provide a calibration folder in <pkg-name>/Finger_files-->
    <param name="finger_calibration_file" value="$(var finger_calibration_file)"/>

    <param name="in_voltage_topic" value="$(var voltage_rect_topic)"/>

    <param name="wrench_topic" value="$(var wrench_topic)"/>
	
  </node>

  <!-- <node if="$(var bool_filter_wrench)" name="filter_wrench"  pkg="sun_ros_utils_nodes" exec="filter_wrench_stamped" output="screen">

    <param name="in_topic" value="$(var wrench_topic)"/>

    <param name="out_topic" value="$(var wrench_filter_topic)"/>

    <param name="cut_freq" value="$(var filter_wrench_cut_freq)"/>
    <param name="rate" value="$(var filter_wrench_rate)"/>

  </node> -->

  <!-- <node if="$(var bool_mov_av_wrench)" name="m_av_wrench"  pkg="sun_ros_utils_nodes" exec="mov_av_wrench_stamped" output="screen">

    <param if="$(var bool_use_filtered_wrench_in_mov_av)" name="in_topic" value="$(var wrench_filter_topic)"/>
    <param unless="$(var bool_use_filtered_wrench_in_mov_av)" name="in_topic" value="$(var wrench_topic)"/>

    <param name="out_topic" value="$(var wrench_mov_av_topic)"/>

    <param name="mov_av_wrench_N" value="$(var mov_av_wrench_N)"/>
    <param name="rate" value="$(var mov_av_wrench_rate)"/>

  </node> -->


</launch>